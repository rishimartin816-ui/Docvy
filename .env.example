# Server-only. Required to enable appointment enquiry form submissions.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Optional private appointment enquiry sink. Enable only after verified clinic routes are configured.
DOCVY_CRM_INTAKE_ENABLED=false
DOCVY_CRM_INTAKE_URL=
DOCVY_CRM_INTAKE_KEY=

# Staff CRM on the production deployment. Use a verified clinic and a server-only database key.
# Host the existing fictional CRM/booking experience on docvy.in when no live clinic is configured.
DOCVY_CRM_DEMO_ON_SITE=false
DOCVY_CRM_STAGING=false
DOCVY_CRM_STAGING_URL=
DOCVY_CRM_STAGING_KEY=
DOCVY_CRM_LIVE=false
DOCVY_CRM_LIVE_URL=
DOCVY_CRM_LIVE_KEY=
DOCVY_CRM_LIVE_CLINIC_ID=
DOCVY_CRM_LIVE_CLINIC_NAME=

# Enable only on production after configuring the waitlist table and retention workflow.
DOCVY_WAITLIST_ENABLED=false
DOCVY_INDEXING_ENABLED=false
DOCVY_GRIEVANCE_RESPONSE_DAYS=

# Show the public demo notice in demo deployments only.
NEXT_PUBLIC_DEMO_MODE=false

DOCVY_DIRECTORY_INTAKE_ENABLED=false
DOCVY_DIRECTORY_INTAKE_URL=
DOCVY_DIRECTORY_INTAKE_KEY=

# Staging-only booking/approval workflow; never enables production booking.
DOCVY_BOOKING_WORKFLOW_ENABLED=false
# Requires existing DOCVY_CRM_STAGING, URL and server-only service key.

# Central DOCVY booking. Server-only secrets; disabled until release checklist passes.
DOCVY_HYBRID_BOOKING_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Generate independent random values of at least 32 characters. Never expose to clients.
DOCVY_BOOKING_PATIENT_SECRET=
DOCVY_BOOKING_RATE_SECRET=
# Enable only after real SMTP/OTP delivery and templates are verified in staging.
DOCVY_PATIENT_AUTH_ENABLED=false

# Owner-approved founder notification recipient (delivery integration still required).
DOCVY_BOOKING_ALERT_EMAIL=rishimartin@docvy.in

# Approved launch model: founder controls all appointments; no clinic CRM accounts required.
DOCVY_BOOKING_CLINIC_ACCESS_ENABLED=false

# Reuse the existing Partner with us Resend credential (server-only).
RESEND_API_KEY=
# Legacy deployed alias is also supported: resend_api_key
DOCVY_BOOKING_EMAIL_ENABLED=false
# Required by an authenticated recurring scheduler calling /api/booking/notifications.
CRON_SECRET=
# Preview delivery requires the staging DB and rewrites ALL recipients to this approved address.
DOCVY_BOOKING_STAGING_EMAIL_TO=
# Optional explicit HTTPS preview URL; otherwise the platform VERCEL_URL is used.
DOCVY_BOOKING_STAGING_SITE_URL=
