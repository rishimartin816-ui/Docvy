# Server-only. Required to enable appointment enquiry form submissions.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Server-only reads of the existing public directory RPC. Existing Vercel
# Supabase integration variables are supported; no database writes are made.
SUPABASE_URL=https://cxyscxjauxoizvvllmfu.supabase.co
# Publishable (sb_publishable_...) or legacy anon key only. Never service_role.
SUPABASE_PUBLISHABLE_KEY=
# Existing profile-branch DOCVY_DIRECTORY_INTAKE_URL/KEY overrides also work.
# DOCVY_DIRECTORY_INTAKE_ENABLED=false explicitly disables public reads.
