# Server-only. Required to enable appointment enquiry form submissions.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Optional private appointment enquiry sink. Enable only after verified clinic routes are configured.
DOCVY_CRM_INTAKE_ENABLED=false
DOCVY_CRM_INTAKE_URL=
DOCVY_CRM_INTAKE_KEY=

# Staff CRM on the production deployment. Use a verified clinic and a server-only database key.
DOCVY_CRM_LIVE=false
DOCVY_CRM_LIVE_URL=
DOCVY_CRM_LIVE_KEY=
DOCVY_CRM_LIVE_CLINIC_ID=
DOCVY_CRM_LIVE_CLINIC_NAME=

# Enable only on production after configuring the waitlist table and retention workflow.
DOCVY_WAITLIST_ENABLED=false
DOCVY_INDEXING_ENABLED=false
DOCVY_GRIEVANCE_RESPONSE_DAYS=

# Show the public demo notice in demo deployments only.
NEXT_PUBLIC_DEMO_MODE=false

# DOCVY coordination queue, separate from provider clinic calendars. Server-side only.
DOCVY_DIRECTORY_INTAKE_ENABLED=false
DOCVY_DIRECTORY_INTAKE_URL=
DOCVY_DIRECTORY_INTAKE_KEY=
